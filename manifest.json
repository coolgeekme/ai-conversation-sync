{
  "manifest_version": 3,
  "name": "AI Conversation Sync",
  "version": "1.0",
  "description": "Sync ChatGPT & Claude conversations to your Hermes Topic Dashboard",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.svg"
  }
}
